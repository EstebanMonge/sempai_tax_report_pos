<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- POS TAX REPORT WIZARD VIEW -->
    <!-- ============================================================ -->

    <record id="view_sempai_tax_report_pos_wizard" model="ir.ui.view">
        <field name="name">sempai.tax.report.pos.wizard.form</field>
        <field name="model">sempai.tax.report.pos.wizard</field>

        <field name="arch" type="xml">
            <form string="Sempai Space POS Tax Report">

                <group>
                    <group>
                        <field name="date_start"/>
                    </group>

                    <group>
                        <field name="date_end"/>
                    </group>
                </group>

                <footer>
                    <button
                        name="action_print_report"
                        string="Print PDF"
                        type="object"
                        class="oe_highlight"/>

                    <button
                        string="Cancel"
                        class="oe_link"
                        special="cancel"/>
                </footer>

            </form>
        </field>
    </record>


    <!-- ============================================================ -->
    <!-- WIZARD ACTION -->
    <!-- ============================================================ -->

<record id="action_sempai_tax_report_pos_wizard" model="ir.actions.act_window">
    <field name="name">Sempai Space POS Tax Report</field>
    <field name="res_model">sempai.tax.report.pos.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>

    <!-- ============================================================ -->
    <!-- POS MENU -->
    <!-- ============================================================ -->

    <menuitem
        id="menu_sempai_tax_report_pos"
        name="Sempai Space Tax Report"
        parent="point_of_sale.menu_point_rep"
        action="action_sempai_tax_report_pos_wizard"
        sequence="50"
        groups="point_of_sale.group_pos_manager"/>
</odoo>
