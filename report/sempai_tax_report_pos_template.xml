<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="sempai_tax_report_pos_document">
        <t t-call="web.html_container">

            <div class="page">

                <h2>Sempai Tax Report - POS</h2>

                <p>
                    Start Date:
                    <span t-esc="date_start"/>
                </p>

                <p>
                    End Date:
                    <span t-esc="date_end"/>
                </p>

                <p>
                    Sale Invoices Found:
                    <span t-esc="len(pos_orders)"/>
                </p>

                <br/>

                <h3 style="margin-top: 20px;">
                    Sales
                </h3>

                <t t-if="pos_orders">

                    <table class="table table-bordered">

                        <thead>
                            <tr>
                                <th>Invoice</th>
                                <th>Date</th>
                                <th>Partner</th>
                                <th>Subtotal</th>
                                <th class="text-right">Taxes</th>
                                <th class="text-right">Total</th>
                            </tr>
                        </thead>

                        <tbody>

                            <t t-foreach="pos_orders" t-as="order">

                                <tr>

                                    <td>
                                        <span t-esc="order.name"/>
                                    </td>

                                    <td>
                                        <span t-esc="order.date_order"/>
                                    </td>

                                    <td>
                                        <span
                                            t-esc="order.partner_id.display_name if order.partner_id else ''"
                                        />
                                    </td>

                                    <td>
                                       <span t-esc="'%.2f' % (order.amount_total - order.amount_tax)"/>
                                    </td>

                                    <td class="text-right">
                                        <span t-esc="'%.2f' % order.amount_tax"/>
                                    </td>

                                    <td class="text-right">
                                        <span t-esc="'%.2f' % order.amount_total"/>
                                    </td>

                                </tr>

                            </t>
<tr>
    <td colspan="3" class="text-right">
        <strong>Total Sales</strong>
    </td>

    <td class="text-right">
        <strong>
            <span t-esc="'%.2f' % sales_subtotal"/>
        </strong>
    </td>

    <td class="text-right">
        <strong>
            <span t-esc="'%.2f' % sales_tax"/>
        </strong>
    </td>

    <td class="text-right">
        <strong>
            <span t-esc="'%.2f' % sales_total"/>
        </strong>
    </td>
</tr>
                        </tbody>

                    </table>

                </t>

                <t t-if="not pos_orders">

                    <p>
                        No POS orders found for this period.
                    </p>

                </t>
                <h3 style="margin-top: 30px;">
                    Sales Tax Summary
                </h3>

                <t t-if="tax_groups">

                    <table class="table table-condensed">

                        <thead>
                            <tr>
                                <th>Tax Group</th>
                                <th class="text-right">Subtotal</th>
                                <th class="text-right">Taxes</th>
                                <th class="text-right">Total</th>
                            </tr>
                        </thead>

                        <tbody>

                            <t t-foreach="tax_groups.values()" t-as="tax_group">

                                <tr>

                                    <td>
                                        <span t-esc="tax_group['name']"/>
                                    </td>

                                    <td class="text-right">
                                        <span
                                            t-esc="'%.2f' % tax_group['subtotal']"
                                        />
                                    </td>

                                    <td class="text-right">
                                        <span
                                            t-esc="'%.2f' % tax_group['tax']"
                                        />
                                    </td>

                                    <td class="text-right">
                                        <span
                                            t-esc="'%.2f' % tax_group['total']"
                                        />
                                    </td>

                                </tr>

                            </t>

                        </tbody>

                    </table>

                </t>

                <t t-if="not tax_groups">

                    <p>
                        No taxes found for this period.
                    </p>

                </t>
            </div>

        </t>
    </template>

</odoo>
